    {
      "name": "ae07aad3",
      "displayName": "Aggregate Count of Gold Line Reliability Entries",
      "queryLines": [
        "SELECT \r\n",
        "COUNT(line_id) AS total_lines\r\n",
        " FROM tfl_pipeline.gold.line_reliability"
      ],
      "catalog": "try_project_cat",
      "schema": "try_project_sch"
    },
    {
      "name": "a845047e",
      "displayName": "Good Service Count",
      "queryLines": [
        "SELECT\r\n",
        "COUNT(statusSeverityDescription) AS good_service\r\n",
        "FROM tfl_pipeline.gold.line_status_daily\r\n",
        "WHERE observation_date = current_date()\r\n",
        "    AND statusSeverityDescription = 'Good Service';"
      ]
    },
    {
      "name": "826a7a4a",
      "displayName": "Other Status Count",
      "queryLines": [
        "SELECT\r\n",
        "COUNT(statusSeverityDescription) AS other_statuses\r\n",
        "FROM tfl_pipeline.gold.line_status_daily\r\n",
        "WHERE observation_date = current_date() AND statusSeverityDescription != 'Good Service';"
      ]
    },
    {
      "name": "1e48d107",
      "displayName": "Daily Gold Status Overview",
      "queryLines": [
        "SELECT\r\n",
        "statusSeverityDescription AS Status,\r\n",
        "COUNT(statusSeverityDescription) AS Count\r\n",
        "FROM tfl_pipeline.gold.line_status_daily\r\n",
        "WHERE observation_date = current_date()\r\n",
        "GROUP BY statusSeverityDescription"
      ]
    },
    {
      "name": "ced0af97",
      "displayName": "Daily special and minor",
      "queryLines": [
        "WITH status_count AS (\r\n",
        "SELECT\r\n",
        "statusSeverityDescription AS Status,\r\n",
        "COUNT(statusSeverityDescription) AS Count\r\n",
        "FROM tfl_pipeline.gold.line_status_daily\r\n",
        "WHERE observation_date = current_date()\r\n",
        "GROUP BY statusSeverityDescription\r\n",
        ")\r\n",
        "SELECT\r\n",
        "Status,\r\n",
        "Count\r\n",
        "FROM status_count\r\n",
        "WHERE Count = (SELECT MIN(Count) FROM status_count)\r\n",
        "\r\n"
      ]
    },
    {
      "name": "39cf2aca",
      "displayName": "balkendiagramm",
      "queryLines": [
        "SELECT \r\n",
        "observation_date,\r\n",
        "statusSeverityDescription,\r\n",
        "SUM(observation_count)\r\n",
        "FROM tfl_pipeline.gold.line_status_daily\r\n",
        "WHERE statusSeverityDescription != 'Good Service' AND statusSeverityDescription != \"Special Service\"\r\n",
        "GROUP BY observation_date, statusSeverityDescription\r\n",
        "\r\n",
        "\r\n",
        "\r\n",
        "\r\n"
      ]
    },
    {
      "name": "2671ca5f",
      "displayName": "Daily Delay",
      "queryLines": [
        "SELECT\r\n",
        "    observation_date,\r\n",
        "    ROUND(\r\n",
        "        100.0 * SUM(\r\n",
        "            CASE\r\n",
        "                WHEN statusSeverity IN (6, 9)\r\n",
        "                THEN observation_count\r\n",
        "                ELSE 0\r\n",
        "            END\r\n",
        "        ) / NULLIF(SUM(observation_count), 0),\r\n",
        "        2\r\n",
        "    ) AS daily_delay_pct\r\n",
        "FROM tfl_pipeline.gold.line_status_daily\r\n",
        "GROUP BY observation_date\r\n",
        "ORDER BY observation_date;"
      ]
    },
    {
      "name": "a5768e98",
      "displayName": "Monthly Line Comparison",
      "queryLines": [
        "SELECT\r\n",
        "    line_id,\r\n",
        "    year_month,\r\n",
        "    total_observations,\r\n",
        "    delay_observations_pct,\r\n",
        "    ROUND(good_service_observations / total_observations * 100, 2) AS good_service_pct,\r\n",
        "    special_or_delay_pct\r\n",
        "FROM tfl_pipeline.gold.line_reliability\r\n",
        "WHERE year_month = '2026-11'\r\n",
        "  AND line_id IN (\r\n",
        "      'bakerloo',\r\n",
        "      'central',\r\n",
        "      'circle',\r\n",
        "      'district',\r\n",
        "      'hammersmith-city',\r\n",
        "      'jubilee',\r\n",
        "      'metropolitan',\r\n",
        "      'northern',\r\n",
        "      'piccadilly',\r\n",
        "      'victoria',\r\n",
        "      'waterloo-city'\r\n",
        "  )\r\n",
        "ORDER BY delay_observations_pct DESC\r\n",
        "LIMIT 10;\r\n",
        "\r\n"
      ]
    }
  ],
